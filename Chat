	local ParticlesFrame = Instance.new("Frame")
	ParticlesFrame.Size = UDim2.new(1, 0, 1, 0)
	ParticlesFrame.BackgroundTransparency = 1
	ParticlesFrame.ZIndex = 101
	ParticlesFrame.Parent = Frame

	local particulas = {}
	for i = 1, 20 do
		local p = Instance.new("Frame")
		p.Size = UDim2.new(0, math.random(2, 4), 0, math.random(2, 4))
		p.Position = UDim2.new(math.random(), 0, math.random(), 0)
		p.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		p.BackgroundTransparency = math.random(3, 7) / 10
		p.BorderSizePixel = 0
		p.ZIndex = 101
		p.Parent = ParticlesFrame
		
		table.insert(particulas, {
			Frame = p,
			Velocidad = math.random(15, 40) / 10000
		})
	end

	RunService.RenderStepped:Connect(function()
		for _, pData in ipairs(particulas) do
			local pos = pData.Frame.Position
			local newY = pos.Y.Scale + pData.Velocidad
			if newY > 1 then newY = -0.02 end
			pData.Frame.Position = UDim2.new(pos.X.Scale, 0, newY, 0)
		end
