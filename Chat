					ui.Button.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
				end
				
				local callback = ScriptsData[name]
				if callback then
					task.spawn(function()
						local success, err = pcall(callback)
						if not success then
							warn("[Xenon Hub Error - " .. tostring(name) .. "]: " .. tostring(err))
