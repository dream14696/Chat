local ultimoTextoTraducido = ""
local contadorPeticion = 0

local function ProcesarTraduccion()
	local textoOriginal = TextBox.Text
	if #textoOriginal:gsub("%s+", "") == 0 then
		ultimoTextoTraducido = ""
		PreviewLabel.Text = " <i>Vista previa traducida...</i>"
		return
	end

	contadorPeticion = contadorPeticion + 1
	local miId = contadorPeticion

	task.spawn(function()
		task.wait(0.25)
		if miId == contadorPeticion then
			PreviewLabel.Text = " <i>Traduciendo...</i>"
			local resultado = traducirTexto(textoOriginal, "es", idiomaSeleccionado)
			if miId == contadorPeticion then
				ultimoTextoTraducido = resultado
				PreviewLabel.Text = " " .. resultado
			end
		end
	end)
end

