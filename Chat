local function createVerticalButton(text, posOffset)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 50, 0, 50)
    btn.Position = UDim2.new(1, -70, 0.5, posOffset)
    btn.Text = text
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    btn.BackgroundTransparency = 0.3
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.Code
    btn.TextSize = 24
    btn.Visible = false
    btn.Parent = screenGui
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn
    
    return btn
end

local upButton = createVerticalButton("▲", -60)
local downButton = createVerticalButton("▼", 10)

-- === SISTEMA DE ARRASTRE PARA EL BOTÓN PRINCIPAL ===
local dragging, dragInput, dragStart, startPos

button.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = button.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

button.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        button.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- === LÓGICA DE MOVIMIENTO VERTICAL (BOTONES) ===
local verticalMove = 0

local function bindVerticalButton(btn, directionValue)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            verticalMove = directionValue
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            verticalMove = 0
        end
    end)
end

bindVerticalButton(upButton, 1)   -- Sube la cámara
bindVerticalButton(downButton, -1) -- Baja la cámara

-- === LÓGICA DE LA CÁMARA LIBRE ===
local isFreecam = false
local speed = 50
local connection
local freecamPart
local originalMinZoom, originalMaxZoom

button.MouseButton1Click:Connect(function()
    isFreecam = not isFreecam
    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")

    if isFreecam then
        button.Text = "cámara desactivar"
        button.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
        upButton.Visible = true
        downButton.Visible = true
        
        if hrp then hrp.Anchored = true end
        
        freecamPart = Instance.new("Part")
        freecamPart.Size = Vector3.new(1, 1, 1)
        freecamPart.Transparency = 1
        freecamPart.CanCollide = false
        freecamPart.Anchored = true
        freecamPart.CFrame = camera.CFrame
        freecamPart.Parent = Workspace
        
        originalMinZoom = player.CameraMinZoomDistance
        originalMaxZoom = player.CameraMaxZoomDistance
        player.CameraMinZoomDistance = 0.5
        player.CameraMaxZoomDistance = 0.5
        
        camera.CameraSubject = freecamPart
        
        connection = RunService.RenderStepped:Connect(function(dt)
            local joyVector = Controls:GetMoveVector()
            local cf = camera.CFrame
            local moveOffset = (cf.RightVector * joyVector.X) + (cf.LookVector * -joyVector.Z) + (cf.UpVector * verticalMove)
            
            if moveOffset.Magnitude > 0 then
                moveOffset = moveOffset.Unit
            end
            
            freecamPart.CFrame = freecamPart.CFrame + (moveOffset * speed * dt)
        end)
    else
        button.Text = "cámara activar"
        button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        upButton.Visible = false
        downButton.Visible = false
        verticalMove = 0
        
        if hrp then hrp.Anchored = false end
        if connection then connection:Disconnect() end
        if freecamPart then freecamPart:Destroy() end
        
        if originalMinZoom and originalMaxZoom then
            player.CameraMinZoomDistance = originalMinZoom
            player.CameraMaxZoomDistance = originalMaxZoom
        end
        camera.CameraSubject = character and character:FindFirstChild("Humanoid")
    end
end)

