	TextBox.TextSize = 13
	TextBox.Font = Enum.Font.SourceSans
	TextBox.ZIndex = 102
	TextBox.Parent = Frame

	local TextCorner = Instance.new("UICorner", TextBox)
	TextCorner.CornerRadius = UDim.new(0, 5)

	local ultimoTextoTraducido = ""
	local contadorPeticion = 0

	local function ProcesarTraduccion()
		local textoOriginal = TextBox.Text
		if #textoOriginal:gsub("%s+", "") == 0 then
			ultimoTextoTraducido = ""
			PreviewLabel.Text = " <i>Vista previa traducida...</i>"
			return
		end

		contadorPeticion = contadorPeticion + 1
		local miId = contadorPeticion

		task.spawn(function()
			task.wait(0.25)
			if miId == contadorPeticion then
				PreviewLabel.Text = " <i>Traduciendo...</i>"
				local resultado = traducirTexto(textoOriginal, "es", idiomaSeleccionado)
				if miId == contadorPeticion then
					ultimoTextoTraducido = resultado
					PreviewLabel.Text = " " .. resultado
				end
			end
		end)
	end

	for nombreIdioma, codigo in pairs(Idiomas) do
		local ItemBtn = Instance.new("TextButton")
		ItemBtn.Size = UDim2.new(1, 0, 0, 20)
		ItemBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
		ItemBtn.Text = nombreIdioma
		ItemBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		ItemBtn.TextSize = 11
		ItemBtn.ZIndex = 201
		ItemBtn.Parent = DropdownFrame
		
		ItemBtn.MouseButton1Click:Connect(function()
			idiomaSeleccionado = codigo
			SelectorBtn.Text = "Idioma: " .. nombreIdioma
			DropdownFrame.Visible = false
			ProcesarTraduccion()
		end)
	end

	SelectorBtn.MouseButton1Click:Connect(function()
		DropdownFrame.Visible = not DropdownFrame.Visible
	end)

	TextBox:GetPropertyChangedSignal("Text"):Connect(ProcesarTraduccion)

	local function EnviarMensaje()
		if #ultimoTextoTraducido > 0 then
			local mensajeFinal = ultimoTextoTraducido
			TextBox.Text = ""
			ultimoTextoTraducido = ""
			PreviewLabel.Text = " <i>Vista previa traducida...</i>"
			
			task.spawn(function()
				local chatEvents = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
				if chatEvents and chatEvents:FindFirstChild("SayMessageRequest") then
					chatEvents.SayMessageRequest:FireServer(mensajeFinal, "All")
				else
					local textChannels = TextChatService:FindFirstChild("TextChannels")
					if textChannels then
						local general = textChannels:FindFirstChild("RBXGeneral") or textChannels:FindFirstChildOfClass("TextChannel")
						if general then
							general:SendAsync(mensajeFinal)
						end
					end
				end
			end)
		end
	end

	SendBtn.MouseButton1Click:Connect(EnviarMensaje)
	TextBox.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			EnviarMensaje()
		end
	end)

	local function ConectarJugador(player)
		player.Chatted:Connect(function(msg)
			if player ~= LocalPlayer then
				task.spawn(function()
					local trad = traducirTexto(msg, "autodetect", "es")
					AgregarMensajeAGUI(player.DisplayName or player.Name, trad)
				end)
			end
		end)
	end

	for _, p in ipairs(Players:GetPlayers()) do
		ConectarJugador(p)
	end
	Players.PlayerAdded:Connect(ConectarJugador)
end)

