			local ResultAvatar=Instance.new("ImageLabel")
			ResultAvatar.Size=UDim2.fromOffset(100,100)
			ResultAvatar.Position=UDim2.new(.5,-50,0,14)
			ResultAvatar.BackgroundColor3=Color3.fromRGB(10,20,35)
			ResultAvatar.ZIndex=51
			ResultAvatar.Parent=Result

			cr(ResultAvatar,50)
			st(ResultAvatar,Color3.fromRGB(0,160,255),3)

			local ResultName=Instance.new("TextLabel")
			ResultName.Size=UDim2.new(1,-20,0,42)
			ResultName.Position=UDim2.fromOffset(10,128)
			ResultName.BackgroundTransparency=1
			ResultName.Font=Enum.Font.GothamBold
			ResultName.TextSize=15
			ResultName.TextColor3=Color3.new(1,1,1)
			ResultName.TextScaled=true
			ResultName.ZIndex=51
			ResultName.Parent=Result

			local Close=Instance.new("TextButton")
			Close.Size=UDim2.fromOffset(32,32)
			Close.Position=UDim2.new(1,-38,0,5)
			Close.BackgroundTransparency=1
			Close.Text="×"
			Close.Font=Enum.Font.GothamBold
			Close.TextSize=23
			Close.TextColor3=Color3.new(1,1,1)
			Close.ZIndex=52
			Close.Parent=Result

			Close.MouseButton1Click:Connect(function()
				vibrate()
				Result.Visible=false
			end)

			local function showPlayer(p)
				if not p then return end

				pcall(function()
					ResultAvatar.Image=Players:GetUserThumbnailAsync(
						p.UserId,
						Enum.ThumbnailType.HeadShot,
						Enum.ThumbnailSize.Size420x420
					)
				end)

				ResultName.Text=p.DisplayName.."  @"..p.Name
				Result.Visible=true

				task.delay(7,function()
					if Result.Parent then
						Result.Visible=false
					end
				end)
			end

			Guess.MouseButton1Click:Connect(function()
				showPlayer(LastAttacker or findAttacker())
			end)

			GuessAttempt.MouseButton1Click:Connect(function()
				showPlayer(findClosestPlayer())
			end)

			local events=ReplicatedStorage:WaitForChild("events")
			local SlapQueue=events:WaitForChild("SlapQueue")
			local SendSlap=events:WaitForChild("SendSlap")
			local DodgeEvent=events:WaitForChild("Dodge")

			local SlapPower=.99927914142609
			local QueueWaiting=false
			local LastSlapTime=0
			local SlapCooldown=.20

			local function requestOneSlap()
				if not AutoSlap or QueueWaiting then return end
				QueueWaiting=true
				pcall(function()
					SlapQueue:FireServer()
				end)
			end

			local function sendOneSlap()
				if not AutoSlap or not QueueWaiting then return end
				QueueWaiting=false
				local now=os.clock()
				if now-LastSlapTime<SlapCooldown then return end
				LastSlapTime=now

				pcall(function()
					SendSlap:FireServer(SlapPower)
				end)
			end

			SlapQueue.OnClientEvent:Connect(sendOneSlap)

			Auto.MouseButton1Click:Connect(function()
				vibrate()

				AutoSlap=not AutoSlap

				if AutoSlap then
					Auto.Text="Auto Slap     ON"
					Auto.BackgroundColor3=Color3.fromRGB(5,45,25)
					AutoStroke.Color=Color3.fromRGB(30,220,100)

					requestOneSlap()
				else
					Auto.Text="Auto Slap     OFF"
					Auto.BackgroundColor3=Color3.fromRGB(12,16,23)
					AutoStroke.Color=Color3.fromRGB(65,75,95)
				end
			end)
		end
	)
end)
