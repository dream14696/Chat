local function traducirTexto(texto, origen, destino)
	if not texto or #texto:gsub("%s+", "") == 0 then return "" end
	
	local url = "https://api.mymemory.translated.net/get?q=" .. HttpService:UrlEncode(texto) .. "&langpair=" .. origen .. "|" .. destino
	
	local exito, respuesta = pcall(function()
		return game:HttpGet(url)
	end)
	
	if exito and respuesta then
		local exitoJSON, datos = pcall(function()
			return HttpService:JSONDecode(respuesta)
		end)
		if exitoJSON and datos and datos.responseData and datos.responseData.translatedText then
			return datos.responseData.translatedText
		end
	end
	return texto
end

