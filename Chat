local function EnviarMensaje()
	if #ultimoTextoTraducido > 0 then
		local mensajeFinal = ultimoTextoTraducido
		TextBox.Text = ""
		ultimoTextoTraducido = ""
		PreviewLabel.Text = " <i>Vista previa traducida...</i>"
		
		task.spawn(function()
			local chatEvents = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
			if chatEvents and chatEvents:FindFirstChild("SayMessageRequest") then
				chatEvents.SayMessageRequest:FireServer(mensajeFinal, "All")
			else
				local textChannels = TextChatService:FindFirstChild("TextChannels")
				if textChannels me then
					local general = textChannels:FindFirstChild("RBXGeneral") or textChannels:FindFirstChildOfClass("TextChannel")
					if general then
						general:SendAsync(mensajeFinal)
					end
				end
			end
		end)
	end
end

SendBtn.MouseButton1Click:Connect(EnviarMensaje)
TextBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		EnviarMensaje()
	end
end)

local function ConectarJugador(player)
	player.Chatted:Connect(function(msg)
		if player ~= LocalPlayer then
			task.spawn(function()
				local trad = traducirTexto(msg, "autodetect", "es")
				AgregarMensajeAGUI(player.DisplayName or player.Name, trad)
			end)
		end
	end)
end

for _, p in ipairs(Players:GetPlayers()) do
	ConectarJugador(p)
end
Players.PlayerAdded:Connect(ConectarJugador)
